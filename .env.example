# Copy to `.env` for local development. Never commit real secrets.
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
BASE_URL=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1
INVITE_ONLY=true

# Optional
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

